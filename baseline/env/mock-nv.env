# Mock "Clariden": an NVIDIA cluster behind its own FirecREST instance and OIDC client.
# Secrets are read from the variables named here; never write them into this file.
export CLUSTER_LABEL=mock-nv
export FIRECREST_URL="${DAINT_FIRECREST_URL:-https://api.cscs.ch/hpc/firecrest/v2}"
export FIRECREST_TOKEN_URI="https://auth.cscs.ch/auth/realms/firecrest-clients/protocol/openid-connect/token"
export FIRECREST_CLIENT_ID="${MOCK_NV_CLIENT_ID}"
export FIRECREST_CLIENT_SECRET="${MOCK_NV_CLIENT_SECRET}"
export FIRECREST_SYSTEM=daint
export FIRECREST_PARTITION=normal
export FIRECREST_ACCOUNT="${HACKATHON_ACCOUNT}"
export FIRECREST_RESERVATION="${HACKATHON_RESERVATION-firecrest}"
export WORKING_DIR="${HACKATHON_SCRATCH}"
export MOCK_CLUSTER_ARCH=nvidia
export MOCK_FAULT_RATE=0
